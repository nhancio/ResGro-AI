# Copy to Secret Manager or your host env. Same variables work on Netlify (dashboard → Environment).

STRIPE_SECRET_KEY=
STRIPE_SELFSERVE_PRICE_ID=
STRIPE_AUTONOMY_PRICE_ID=

# CORS: comma-separated origins (site + app subdomain)
ALLOWED_ORIGINS=https://resgro.ai,https://www.resgro.ai,https://app.resgro.ai

# Password reset email (EmailJS or SMTP — see apis/netlify/functions/_email.js)
# EmailJS (same keys as the UI; server reads VITE_* or EMAILJS_*)
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=
MAIL_FROM=noreply@yourdomain.com

# Or SMTP (nodemailer):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Optional: link in reset email
APP_ORIGIN=https://app.yourdomain.com

# Admin CRM (comma-separated; must match VITE_ADMIN_EMAILS on the UI)
RESGRO_ADMIN_EMAILS=nithin@theondemandcompany.com,demo@resgro.ai

# Local / staging only — returns full reset token in JSON (never enable in production)
# EXPOSE_RESET_TOKEN_IN_API_RESPONSE=true

PORT=8080
