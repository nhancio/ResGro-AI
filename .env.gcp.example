# Copy to .env.gcp and fill in real values — never commit .env.gcp
# cp .env.gcp.example .env.gcp

GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-west2
GCP_ARTIFACT_REPO=resgro

# Stripe + auth (Node API — apis/http on Cloud Run)
STRIPE_SECRET_KEY=sk_live_YOUR_STRIPE_SECRET_KEY
STRIPE_SELFSERVE_PRICE_ID=price_YOUR_SELFSERVE_PRICE_ID
STRIPE_AUTONOMY_PRICE_ID=price_YOUR_AUTONOMY_PRICE_ID
ALLOWED_ORIGINS=https://resgro.ai,https://www.resgro.ai,https://app.resgro.ai
RESGRO_ADMIN_EMAILS=you@example.com
MAIL_FROM=noreply@resgro.ai
APP_ORIGIN=https://app.resgro.ai

# UI build (Vite — Netlify: ./deploy.sh netlify prod)
VITE_SITE_URL=https://resgro.ai
VITE_APP_URL=https://app.resgro.ai
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_YOUR_STRIPE_PUBLISHABLE_KEY
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id
VITE_ADMIN_EMAILS=you@example.com
VITE_AGENTS_API_URL=https://resgro-agents-api-XXXXXXXX.us-west2.run.app

# Auth API URL for Netlify build (set after first GCP deploy):
# VITE_API_BASE_URL=https://resgro-api-XXXXXXXX.us-west2.run.app

# Django backend (Cloud Run resgro-backend)
DJANGO_SECRET_KEY=change-me-generate-a-long-random-string
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
# DATABASE_URL=postgresql://user:pass@host:5432/resgro
# EXPOSE_RESET_TOKEN_IN_API_RESPONSE=true
# DJANGO_SUPERUSER_EMAIL=you@example.com
# DJANGO_SUPERUSER_PASSWORD=change-me

# Agents API (Cloud Run resgro-agents-api)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash
