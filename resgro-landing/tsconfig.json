{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@agents": ["../agents/index.ts"],
      "@agents/*": ["../agents/*"],
      "@resgro-app/*": ["./src/*"]
    }
  },
  "include": ["src", "../agents/**/*.ts", "../agents/**/*.tsx"]
}
