# Copy to .env.production for local production builds: cp .env.production.example .env.production
# GCP (recommended): use repo-root .env.gcp and ./deploy-gcp.sh — sets VITE_* at Docker build time
# Netlify (legacy): Site settings → Environment variables, or netlify.toml [build.environment]

# Agents API (Python Cloud Run)
VITE_AGENTS_API_URL=https://resgro-agents-api-432223990540.us-west2.run.app

# Stripe/auth/admin API (Node Cloud Run) — required for admin CRM on GCP
# VITE_API_BASE_URL=https://resgro-api-XXXXXXXX.us-west2.run.app

# Comma-separated admin emails (must match RESGRO_ADMIN_EMAILS on the API)
# VITE_ADMIN_EMAILS=nithin@theondemandcompany.com,demo@resgro.ai
