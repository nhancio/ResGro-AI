# ── ResGro AI — Master Environment File ──
# Copy to .env and fill in values. All services source from this file.

# ── GCP ──
GCP_PROJECT_ID=
GCP_REGION=us-west2
GCP_ARTIFACT_REPO=resgro

# ── Stripe ──
STRIPE_SECRET_KEY=sk_live_...
STRIPE_SELFSERVE_PRICE_ID=price_...
STRIPE_AUTONOMY_PRICE_ID=price_...
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Auth / CORS ──
ALLOWED_ORIGINS=https://resgro.ai,https://www.resgro.ai,https://app.resgro.ai
RESGRO_ADMIN_EMAILS=
MAIL_FROM=noreply@resgro.ai
APP_ORIGIN=https://app.resgro.ai

# ── URLs (frontend build + runtime) ──
VITE_SITE_URL=https://resgro.ai
VITE_APP_URL=https://app.resgro.ai
VITE_API_BASE_URL=
VITE_AGENTS_API_URL=
VITE_ADMIN_EMAILS=

# ── EmailJS ──
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=

# ── Django ──
DJANGO_SECRET_KEY=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
# STRIPE_WEBHOOK_SECRET=whsec_...
# DATABASE_URL=postgresql://...

# ── Gemini / AI ──
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── GCS (agents API) ──
GCS_UPLOAD_BUCKET=
GCS_SIGNING_SERVICE_ACCOUNT=

# ── Browser Automation ──
MARKETING_CAMPAIGN_DEBUG=0
USE_LOCAL_BROWSER=true
CHROME_USER_DATA_DIR=~/.chrome-debug-profile-8
